# Copy to .env and adjust as needed. Values match docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@localhost:5432/jobscout
REDIS_URL=redis://localhost:6379/0

# Phase 4 cover-letter generation. Requires a running Ollama server
# (https://ollama.com) with the model pulled, e.g. `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
