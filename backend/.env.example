# Copy to .env and adjust as needed. Values match docker-compose.yml defaults.
DATABASE_URL=postgresql://jobscout:jobscout@localhost:5432/jobscout
REDIS_URL=redis://localhost:6379/0

# --- ingestion sources -------------------------------------------------
# Comma-separated Greenhouse board tokens / Lever site slugs. Find them in
# a company's careers URL: boards.greenhouse.io/<board>, jobs.lever.co/<site>.
# Both APIs are official, documented, and need no key.
GREENHOUSE_BOARDS=
LEVER_SITES=
# hiring.cafe uses an internal, undocumented API; leave disabled until you've
# manually confirmed the request/response shape in sources/hiring_cafe.py.
HIRING_CAFE_ENABLED=false

# Minutes between scheduled ingestion runs (used by `rq cron`).
INGEST_INTERVAL_MINUTES=30

# --- matching (Phase 2) --------------------------------------------------
# 'sentence-transformers': local neural embeddings (default; best quality,
#   needs the ml dependency group — `just install` includes it. ~90MB model
#   downloads from Hugging Face on first use, then runs fully offline).
# 'hashing': dependency-free lexical baseline (works everywhere, weaker
#   semantic matching; used by the test suite).
# Switching providers/models? Run `jobscout embed` to re-embed the corpus.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- copilot LLM (Phase 4) -------------------------------------------------
# 'none' (default): tailoring advice and cover letters are deterministic,
#   clearly-labeled scaffolds — no model needed, nothing leaves your machine.
# 'ollama': local LLM phrases them into prose (install Ollama, then e.g.
#   `ollama pull llama3.1:8b`). Private and free.
# 'anthropic': paid API for best prose (set ANTHROPIC_API_KEY). Unlike the
#   local options, resume/job text is sent to Anthropic.
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
